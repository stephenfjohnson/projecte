{
  "schemaVersion": 1,
  "id": "projecte",
  "version": "${version}",
  "name": "ProjectE",
  "description": "A complete rewrite of EE2 for modern Minecraft versions.",
  "authors": [
    "SinKillerJ",
    "MaPePeR",
    "williewillus",
    "Lilylicious",
    "pupnewfster"
  ],
  "contributors": [
    "x3n0ph0b3 (EE2 creator)",
    "MidnightLightning (EE2 GUI Textures)",
    "Magic Banana (Former Texture Artist)"
  ],
  "contact": {
    "homepage": "https://github.com/sinkillerj/ProjectE",
    "issues": "https://github.com/sinkillerj/ProjectE/issues",
    "sources": "https://github.com/sinkillerj/ProjectE"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "moze_intel.projecte.PECore"
    ],
    "client": [
      "moze_intel.projecte.client.PEClient"
    ],
    "projecte:emc_mappers": [
      "moze_intel.projecte.emc.mappers.BrewingMapper",
      "moze_intel.projecte.emc.mappers.CustomEMCMapper",
      "moze_intel.projecte.emc.mappers.OreBlacklistMapper",
      "moze_intel.projecte.emc.mappers.OxidizationMapper",
      "moze_intel.projecte.emc.mappers.RawMaterialsBlacklistMapper",
      "moze_intel.projecte.emc.mappers.WaxableMapper",
      "moze_intel.projecte.emc.mappers.customConversions.CustomConversionMapper",
      "moze_intel.projecte.emc.mappers.recipe.CraftingMapper"
    ],
    "projecte:recipe_type_mappers": [
      "moze_intel.projecte.emc.mappers.recipe.FallbackRecipeTypeMapper",
      "moze_intel.projecte.emc.mappers.recipe.SmithingRecipeMapper",
      "moze_intel.projecte.emc.mappers.recipe.VanillaRecipeTypeMapper",
      "moze_intel.projecte.emc.mappers.recipe.special.ShulkerRecoloringMapper",
      "moze_intel.projecte.emc.mappers.recipe.special.SpecialRecipeMarkHandledMapper",
      "moze_intel.projecte.emc.mappers.recipe.special.SuspiciousStewMapper",
      "moze_intel.projecte.emc.mappers.recipe.special.TippedArrowMapper"
    ],
    "projecte:data_component_processors": [
      "moze_intel.projecte.emc.components.processor.ArmorTrimProcessor",
      "moze_intel.projecte.emc.components.processor.BannerProcessor",
      "moze_intel.projecte.emc.components.processor.BundleProcessor",
      "moze_intel.projecte.emc.components.processor.ContainerProcessor",
      "moze_intel.projecte.emc.components.processor.DamageProcessor",
      "moze_intel.projecte.emc.components.processor.DecoratedPotProcessor",
      "moze_intel.projecte.emc.components.processor.DecoratedShieldProcessor",
      "moze_intel.projecte.emc.components.processor.EnchantmentProcessor",
      "moze_intel.projecte.emc.components.processor.FireworkProcessor",
      "moze_intel.projecte.emc.components.processor.FireworkStarProcessor",
      "moze_intel.projecte.emc.components.processor.MapScaleProcessor",
      "moze_intel.projecte.emc.components.processor.MercurialEyeProcessor",
      "moze_intel.projecte.emc.components.processor.StoredEMCProcessor",
      "moze_intel.projecte.emc.components.processor.WritableBookProcessor",
      "moze_intel.projecte.emc.components.processor.WrittenBookProcessor"
    ]
  },
  "mixins": [
    "projecte.mixins.json",
    {
      "config": "projecte.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "projecte.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "forgeconfigapiport": "*"
  },
  "breaks": {
    "mekanism": "<=10.7.8"
  }
}
